# Sao chép thành .env rồi sửa. .env KHÔNG commit (xem .gitignore).
#
# Hai profile, cùng một docker-compose. Xem bảng "Ngân sách disk" trong CLAUDE.md.

# ─── Profile RỘNG (≥20GB trống) — đang dùng ───
KAFKA_RETENTION_BYTES=8589934592
KAFKA_RETENTION_MS=604800000

# ─── Profile CHẬT (<15GB trống) — đổi sang hai dòng này ───
# KAFKA_RETENTION_BYTES=268435456
# KAFKA_RETENTION_MS=3600000

# ⚠ Đừng hạ retention xuống dưới vài giờ ở profile rộng: mất khả năng replay
# từ earliest, không thử được --reset-offsets, và thí nghiệm record trễ 3 giờ
# mất bản ghi gốc trước khi kịp so sánh.

POSTGRES_USER=tradewatch
POSTGRES_DB=tradewatch
POSTGRES_PASSWORD=doi-gia-tri-nay
